extends Node3D

# Single-player, locally directed prologue. Never sends camera RPCs.
# Authored GLB room/desk are already present in the first-floor level.
const Assets = preload("backrooms_assets.gd")
const FAR := Vector3(1.55, 1.85, 2.45)
const NEAR := Vector3(0.22, 1.08, 0.12)
const PHONE_AT := Vector3(0.15, 0.795, -0.45)
const PUSH_SECONDS := 2.65
const RING_SECONDS := 2.0
const STATIC_SECONDS := 2.5
const FALL_SECONDS := 2.05
const WAKE_SECONDS := 6.2
const BLACK_SECONDS := 1.1
const CLANG_AT := 4.1
const SMILER_WATCH := 1.9
const SMILER_GAP := 0.68
const SMILER_NEAR := 0.25
const SMILER_STARE := 0.55

var game: Node
var camera: Camera3D
var phone: Node3D
var witness: Node3D
var ringtone: AudioStreamPlayer3D
var hangup: AudioStreamPlayer
var interference: AudioStreamPlayer3D
var fall_audio: AudioStreamPlayer
var phase := "inactive"
var clock := 0.0
var active := false
var answered := false
var model_is_iphone17 := false
var screen_viewport: SubViewport
var screen_label: Label
var screen_surface: MeshInstance3D
var wake_camera: Camera3D
var wake_hands: Node3D
var smiler_clock := 0.0
var turned_for_smiler := false
var initial_wake_yaw := 0.0
var clang_triggered := false
var wake_yaw := 0.0
var wake_pitch := 0.0

func _ready() -> void:
	name = "OtherShiftPrologue"
	camera = Camera3D.new()
	camera.name = "SurveillanceToPhoneCamera"
	camera.fov = 59.0
	camera.near = 0.025
	add_child(camera)
	camera.position = FAR
	camera.look_at(PHONE_AT)
	camera.current = false
	# A correctly licensed high-detail iPhone model can be installed under
	# iphone17_pro.glb; until then a real third-party phone GLB is required.
	var exact_path := Assets.path("vendor/iphone17_pro.glb")
	model_is_iphone17 = ResourceLoader.exists(exact_path)
	var phone_file := "vendor/iphone17_pro.glb" if model_is_iphone17 else "vendor/phone_fallback.glb"
	if not ResourceLoader.exists(Assets.path(phone_file)):
		push_error("Prologue phone GLB unavailable: " + phone_file)
	else:
		phone = Assets.fitted(phone_file, 0.158)
		phone.name = "LicensedPhoneGLB"
		phone.position = PHONE_AT
		phone.rotation.x = -PI * 0.5
		# A portrait phone faces the incoming camera; never lay the model on its back.
		phone.rotation.y = PI # Back of handset faces ring listener while device lies flat.
		add_child(phone)
	# This is a true in-world emissive screen over the externally authored phone GLB.
	# Texture is generated by a 2D SubViewport; text is NOT a fullscreen overlay.
	screen_viewport = SubViewport.new()
	screen_viewport.size = Vector2i(512,1024)
	screen_viewport.transparent_bg = false
	screen_viewport.render_target_update_mode = SubViewport.UPDATE_ALWAYS
	add_child(screen_viewport)
	var face := ColorRect.new()
	face.size = Vector2(512,1024)
	face.color = Color(0.018,0.027,0.046)
	screen_viewport.add_child(face)
	screen_label = Label.new()
	screen_label.position = Vector2(25,310)
	screen_label.size = Vector2(462,230)
	screen_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	screen_label.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	screen_label.add_theme_font_size_override("font_size",52)
	screen_label.add_theme_color_override("font_color",Color(0.92,0.95,1.0))
	face.add_child(screen_label)
	var screen_mesh := QuadMesh.new()
	screen_mesh.size = Vector2(0.073,0.144)
	screen_surface = MeshInstance3D.new()
	screen_surface.name = "PhoneScreen_UnknownCaller_InWorld"
	screen_surface.mesh = screen_mesh
	var screen_material := StandardMaterial3D.new()
	screen_material.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	screen_material.albedo_texture = screen_viewport.get_texture()
	screen_material.cull_mode = BaseMaterial3D.CULL_DISABLED
	screen_surface.material_override = screen_material
	screen_surface.position = PHONE_AT + Vector3(0,0.079,0.017)
	add_child(screen_surface)
	# Camera-facing screen layer stays near the actual iPhone and carries no HUD.
	screen_surface.rotation = Vector3.ZERO
	# QuadMesh front normal and the phone both face +Z (towards the dolly).
	screen_surface.visible = false
	wake_camera = Camera3D.new()
	wake_camera.name = "GroundToDarkness_FirstPerson"
	wake_camera.fov = 73.0
	add_child(wake_camera)
	wake_camera.position = Vector3(0,0.32,3.1)
	wake_camera.look_at(Vector3(0,-0.4,0.35))
	# Reuse the genuine skinned, license-tracked first-person arm GLB.
	if ResourceLoader.exists(Assets.path("vendor/sketchfab_fps_arms.glb")):
		wake_hands = Node3D.new()
		wake_hands.name = "WakingSkinnedFirstPersonHands"
		wake_hands.position = Vector3(0,-1.49,-0.59)
		wake_hands.rotation.y = PI
		wake_camera.add_child(wake_hands)
		wake_hands.add_child(load(Assets.path("vendor/sketchfab_fps_arms.glb")).instantiate())
		wake_hands.visible = false
		for anim_node in wake_hands.find_children("*","AnimationPlayer",true,false):
			var anim := anim_node as AnimationPlayer
			for clip in anim.get_animation_list():
				if clip == "RESET": continue
				anim.play(clip)
				anim.speed_scale = 0.12
				break
	# The silent person in the recovered recording is a real skinned GLB,
	# not a generated primitive; this figure does not appear in multiplayer.
	if ResourceLoader.exists(Assets.path("vendor/crew.glb")):
		witness = Assets.fitted("vendor/crew.glb", 1.73)
		witness.name = "SeatedInvestigatorSilhouette"
		witness.position = Vector3(-1.65, 0.0, 4.25)
		witness.rotation.y = -0.7
		add_child(witness)
		for anim_node in witness.find_children("*", "AnimationPlayer", true, false):
			var animator := anim_node as AnimationPlayer
			animator.speed_scale = 0.0
	ringtone = AudioStreamPlayer3D.new()
	ringtone.name = "IncomingCall3D"
	ringtone.position = PHONE_AT + Vector3(0, -0.012, 0) # Spatial source from rear cover.
	ringtone.max_distance = 16.0
	ringtone.unit_size = 1.1
	_apply_sound(ringtone, "phone_ring.wav")
	add_child(ringtone)
	hangup = AudioStreamPlayer.new()
	hangup.name = "CallDisconnect"
	_apply_sound(hangup, "phone_disconnect.wav")
	add_child(hangup)
	interference = AudioStreamPlayer3D.new()
	interference.name = "MovingRadioStatic"
	interference.max_distance = 24.0
	interference.unit_size = 0.9
	interference.volume_db = -8.0
	_apply_sound(interference, "phone_static.wav")
	add_child(interference)
	fall_audio = AudioStreamPlayer.new()
	fall_audio.name = "LossOfFloor"
	_apply_sound(fall_audio, "phone_fall.wav")
	add_child(fall_audio)
	visible = false
	set_process(false)

func _apply_sound(sound: Node, filename: String) -> void:
	var path := "res://audio/" + filename
	if not ResourceLoader.exists(path):
		path = "res://faceless2/audio/" + filename
	if ResourceLoader.exists(path):
		sound.set("stream", load(path))
	else:
		push_warning("Missing prologue audio: " + filename)

func begin() -> void:
	if not is_instance_valid(phone):
		push_error("Cannot begin opening cinematic without licensed phone GLB.")
		return
	if not is_instance_valid(game) or not is_instance_valid(game.level): return
	_stop_audio()
	game.net.leave()
	game.player.reset_flashlight()
	game.wakeup_room.reset_facility()
	game.running = false
	game.level.visible = false
	game.prologue_room.visible = true
	if is_instance_valid(game.wakeup_room): game.wakeup_room.visible = false
	wake_camera.current = false
	game.player.visible = false
	game.player.set_physics_process(false)
	game.player.cancel_focus()
	game.player.camera.current = false
	visible = true
	camera.make_current()
	camera.position = FAR
	camera.rotation = Vector3.ZERO
	camera.fov = 59.0
	camera.look_at(PHONE_AT)
	answered = false
	clang_triggered = false
	wake_yaw = 0.0
	wake_pitch = 0.0
	screen_surface.visible = false
	smiler_clock = 0.0
	turned_for_smiler = false
	clock = 0.0
	phase = "push"
	active = true
	set_process(true)
	game.ui.open_prologue()
	game.ui.prologue_stage("push")

func update_phone_language() -> void:
	if not is_instance_valid(screen_label): return
	if phase == "ring":
		screen_label.text = "未知号码" if game.language == "zh" else "UNKNOWN\nCALLER"

func answer() -> void:
	if not active or phase != "ring" or answered: return
	answered = true
	if ringtone.playing: ringtone.stop()
	_transition("disconnect")

func _transition(next_phase: String) -> void:
	phase = next_phase
	clock = 0.0
	game.ui.prologue_stage(next_phase)
	if next_phase == "smiler_watch": game.wakeup_room.smiler_stage(0.0, "watch")
	if next_phase == "smiler_gap": game.wakeup_room.smiler_stage(0.0, "hidden")
	if next_phase == "smiler_near": game.wakeup_room.smiler_stage(0.0, "near")
	if next_phase == "smiler_wait_turn":
		game.ui.prologue_wake_clear()
	if next_phase == "smiler_near" and game.wakeup_room.smiler_sound.stream != null:
		game.wakeup_room.smiler_sound.play()
	if next_phase == "ring":
		screen_surface.visible = false # No text or non-authored phone overlay in this cut.
	elif next_phase == "disconnect":
		pass
	elif next_phase == "static":
		pass
	elif next_phase == "black":
		screen_surface.visible = false
		game.ui.prologue_fade(1.0)
	elif next_phase == "wake":
		game.prologue_room.visible = false
		game.wakeup_room.visible = true
		game.wakeup_room.set_physics_active(true)
		# Legacy audio/water are silent while exploring the independently streamed facility.
		if game.ambience.playing: game.ambience.stop()
		if is_instance_valid(game.flooded_ambience): game.flooded_ambience.stop()
		# No luminous world beyond the sealed black-site tunnel.
		game.environment.environment.background_color = Color(0.004,0.007,0.011)
		game.environment.environment.ambient_light_energy = 0.13
		game.environment.environment.fog_light_color = Color(0.01,0.018,0.025)
		if game.wakeup_room.low_rumble.stream != null: game.wakeup_room.low_rumble.play()
		camera.current = false
		wake_camera.position = game.wakeup_room.CAMERA_GROUND
		wake_camera.look_at(game.wakeup_room.LOOK_GROUND)
		wake_camera.make_current()
	match next_phase:
		"ring":
			if ringtone.stream != null: ringtone.play()
		"disconnect":
			if hangup.stream != null: hangup.play()
		"static":
			if interference.stream != null: interference.play()
		"fall":
			if interference.playing: interference.stop()
			if fall_audio.stream != null: fall_audio.play()

func _process(delta: float) -> void:
	advance(delta)

func advance(delta: float) -> void:
	if not active or delta <= 0: return
	clock += minf(delta, 0.15)
	match phase:
		"push":
			var t := smoothstep(0.0, PUSH_SECONDS, clock)
			camera.position = FAR.lerp(NEAR, t)
			# Room has a 3.12m ceiling: prevent any shoulder/zoom overshoot.
			camera.position.y = clampf(camera.position.y, 0.9, 2.2)
			camera.look_at(PHONE_AT + Vector3(0, 0.08, 0), Vector3.UP)
			camera.fov = lerpf(59.0, 42.0, t)
			if clock >= PUSH_SECONDS: _transition("ring")
		"ring":
			# The protagonist answers even when players do not tap the screen;
			# touch/E can accelerate this event.
			if clock >= RING_SECONDS: answer()
		"disconnect":
			if clock >= 0.40: _transition("static")
		"static":
			# The noise begins on the phone and circles the local listener.
			var angle := clock * TAU / STATIC_SECONDS
			var position_around := Vector3(sin(angle) * 1.6, 0.08 + sin(angle * 0.7) * 0.3, cos(angle) * 1.6)
			interference.global_position = camera.global_position + position_around
			camera.rotation.z = sin(clock * 8.0) * 0.014
			if clock >= STATIC_SECONDS: _transition("fall")
		"fall":
			var descent := clock / FALL_SECONDS
			camera.position.y = NEAR.y - 7.2 * descent * descent
			camera.rotation.z = lerpf(0.0, 0.24, descent)
			camera.fov = lerpf(42.0, 74.0, descent)
			game.ui.prologue_fade(smoothstep(0.45, 1.0, descent))
			if clock >= FALL_SECONDS: _transition("black")
		"black":
			if clock >= BLACK_SECONDS: _transition("wake")
		"wake":
			if not clang_triggered and clock >= CLANG_AT:
				clang_triggered = true
				if game.wakeup_room.far_clang.stream != null: game.wakeup_room.far_clang.play()
			var waking := smoothstep(0.0, WAKE_SECONDS, clock)
			if is_instance_valid(wake_hands): wake_hands.visible = waking > 0.40
			wake_camera.position = game.wakeup_room.CAMERA_GROUND.lerp(game.wakeup_room.CAMERA_UP,waking)
			wake_camera.look_at(game.wakeup_room.LOOK_GROUND.lerp(game.wakeup_room.LOOK_DARKNESS,waking))
			game.ui.prologue_wake_progress(clock / WAKE_SECONDS)
			if clock >= WAKE_SECONDS: _transition("smiler_wait_turn")
		"smiler_wait_turn":
			# Translation remains frozen; looking around is allowed locally.
			# No automatic scare merely because a timer elapsed.
			if turned_for_smiler:
				_transition("smiler_watch")
		"smiler_watch":
			game.wakeup_room.smiler_stage(0.0, "watch")
			if clock >= SMILER_STARE:
				game.wakeup_room.smiler_stage(0.0, "hidden")
				_transition("smiler_gap")
		"smiler_gap":
			if clock >= SMILER_GAP: _transition("smiler_near")
		"smiler_near":
			game.wakeup_room.smiler_stage(0.0, "near")
			if clock >= SMILER_NEAR:
				game.wakeup_room.smiler_stage(0.0, "hidden")
				finish()

func finish() -> void:
	if not active: return
	_stop_audio()
	phase = "ended"
	active = false
	set_process(false)
	game.wakeup_room.smiler_stage(0.0,"hidden")
	game.player.reset_to(Vector3(0.0,0.10,3.1))
	game.player.visible = true
	game.player.set_physics_process(true)
	game.player.camera.make_current()
	game.player.reset_flashlight()
	if is_instance_valid(wake_hands): wake_hands.visible = false
	game.running = true
	game.ui.prologue_finished()

func exit_to_menu() -> void:
	_stop_audio()
	active = false
	phase = "inactive"
	set_process(false)
	visible = true
	if is_instance_valid(game.wakeup_room):
		game.wakeup_room.visible = false
		game.wakeup_room.set_physics_active(false)
		game.wakeup_room.low_rumble.stop()
		game.wakeup_room.far_clang.stop()
		game.wakeup_room.reset_facility()
	game.environment.environment.background_color = Color(0.028, 0.035, 0.038)
	game.environment.environment.ambient_light_energy = 0.17
	game.environment.environment.fog_light_color = Color(0.13,0.15,0.15)
	wake_camera.current = false
	game.show_title_room()
	game.ui.menu()

func _unhandled_input(event: InputEvent) -> void:
	if phase == "smiler_wait_turn":
		if event is InputEventMouseMotion:
			look_before_smiler(event.relative)
		elif event is InputEventScreenDrag:
			look_before_smiler(event.relative)
		return
	if phase == "ended":
		# Exploration after the awakening is local-only; other players keep their cameras.
		if event is InputEventMouseMotion and Input.is_mouse_button_pressed(MOUSE_BUTTON_RIGHT):
			look_after_wake(event.relative)
		elif event is InputEventScreenDrag:
			look_after_wake(event.relative)
		return
	if not active: return
	if event is InputEventKey and event.pressed and not event.echo:
		if event.physical_keycode == KEY_E or event.physical_keycode == KEY_ENTER:
			answer()
		elif event.physical_keycode == KEY_ESCAPE:
			exit_to_menu()

func look_before_smiler(delta: Vector2) -> void:
	if phase != "smiler_wait_turn": return
	wake_yaw = clampf(wake_yaw-delta.x*0.0028,-PI,PI)
	wake_pitch = clampf(wake_pitch-delta.y*0.0028,-0.60,0.60)
	wake_camera.rotation = Vector3(wake_pitch,wake_yaw,0.0)
	if absf(wake_yaw) >= 1.55:
		turned_for_smiler = true
		# Smiler will be in front of the camera when it snaps back.
		wake_camera.rotation = Vector3.ZERO

func look_after_wake(delta: Vector2) -> void:
	if not is_instance_valid(wake_camera) or phase != "ended": return
	wake_yaw = clampf(wake_yaw-delta.x*0.0023,-1.05,1.05)
	wake_pitch = clampf(wake_pitch-delta.y*0.0023,-0.45,0.62)
	wake_camera.rotation = Vector3(wake_pitch,wake_yaw,0.0)

func _stop_audio() -> void:
	for sound in [ringtone, hangup, interference, fall_audio]:
		if is_instance_valid(sound):
			sound.stop()

func _exit_tree() -> void:
	for sound in [ringtone, hangup, interference, fall_audio]:
		if is_instance_valid(sound):
			sound.stop()
			sound.stream = null
